name: Build Embedded Node APK

on:
  workflow_dispatch:

jobs:
  build:
    name: Build Android APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Setup Node.js
        uses: actions/setup-node@v5
        with:
          node-version: 22

      - name: Setup Java
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: 21

      - name: Install dependencies
        run: npm install

      - name: Install embedded Node.js
        run: npm install @capawesome/capacitor-nodejs@0.1.1

      - name: Prepare local backend
        shell: bash
        run: |
          set -e

          mkdir -p src/lib

          cat > src/lib/localBackend.ts <<'EOF'
          import { Capacitor } from '@capacitor/core';

          const LOCAL_BACKEND_URL = 'http://127.0.0.1:3000';

          export function setupLocalBackend() {
            if (!Capacitor.isNativePlatform()) return;

            const originalFetch = window.fetch.bind(window);

            window.fetch = (
              input: RequestInfo | URL,
              init?: RequestInit
            ) => {
              const url =
                input instanceof Request
                  ? input.url
                  : input instanceof URL
                    ? input.toString()
                    : input;

              if (url.startsWith('/api/')) {
                const target =
                  LOCAL_BACKEND_URL + url;

                if (input instanceof Request) {
                  return originalFetch(
                    new Request(target, input),
                    init
                  );
                }

                return originalFetch(target, init);
              }

              return originalFetch(input, init);
            };
          }
          EOF

          node <<'NODE'
          const fs = require('fs');

          let main = fs.readFileSync(
            'src/main.tsx',
            'utf8'
          );

          const imp =
            "import { setupLocalBackend } from './lib/localBackend.ts';";

          if (!main.includes(imp)) {
            main =
              imp + '\n' + main;
          }

          if (!main.includes('setupLocalBackend();')) {
            const marker =
              "createRoot(document.getElementById('root')!).render(";

            main = main.replace(
              marker,
              "setupLocalBackend();\n\n" + marker
            );
          }

          fs.writeFileSync(
            'src/main.tsx',
            main
          );

          let server = fs.readFileSync(
            'server.ts',
            'utf8'
          );

          if (!server.includes(
            'Access-Control-Allow-Origin'
          )) {
            const marker =
              "app.use(express.json({ limit: '10mb' }));";

            const cors = `
          app.use((req, res, next) => {
            res.setHeader(
              'Access-Control-Allow-Origin',
              '*'
            );
            res.setHeader(
              'Access-Control-Allow-Methods',
              'GET,POST,PUT,PATCH,DELETE,OPTIONS'
            );
            res.setHeader(
              'Access-Control-Allow-Headers',
              'Content-Type, Authorization'
            );

            if (req.method === 'OPTIONS') {
              return res.sendStatus(204);
            }

            next();
          });
          `;

            server = server.replace(
              marker,
              marker + '\\n' + cors
            );
          }

          server = server.replace(
            "app.listen(PORT, '0.0.0.0'",
            "app.listen(PORT, '127.0.0.1'"
          );

          fs.writeFileSync(
            'server.ts',
            server
          );
          NODE

      - name: Build web app
        run: npx vite build

      - name: Bundle backend
        shell: bash
        run: |
          set -e

          mkdir -p dist/nodejs

          npx esbuild server.ts \
            --bundle \
            --platform=node \
            --format=cjs \
            --outfile=dist/nodejs/server.cjs

          cat > dist/nodejs/package.json <<'EOF'
          {
            "name": "xiaoshouji-backend",
            "version": "1.0.0",
            "private": true,
            "main": "server.cjs"
          }
          EOF

          test -s dist/nodejs/server.cjs

      - name: Sync Android
        run: npx cap sync android

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: '8.14.3'
          validate-wrappers: false

      - name: Build APK
        working-directory: android
        run: |
          gradle assembleDebug \
            --stacktrace \
            --console=plain

      - name: Show APK
        run: |
          echo "========== APK =========="
          find android/app/build/outputs \
            -type f \
            -name "*.apk" \
            -print

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: xiaoshouji-apk
          path: android/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
