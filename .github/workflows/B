name: Android CI

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4
      
      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          
      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y git zip unzip openjdk-17-jdk python3-pip autoconf libtool pkg-config zlib1g-dev libncurses5-dev libncursesw5-dev libtinfo5 cmake libffi-dev libssl-dev
          pip install --upgrade pip
          pip install buildozer cython kivy
          
      - name: Build APK with Buildozer
        run: |
          # 假设你的入口文件是 main.py，请根据实际修改
          buildozer android debug
        env:
          # Buildozer 会自动处理 Android SDK 和 NDK 的下载与配置
          ANDROID_SDK_HOME: /home/runner/.buildozer/android/platform/android-sdk-33
          ANDROID_NDK_HOME: /home/runner/.buildozer/android/platform/android-ndk-r25b
          
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: kivy-app-apk
          path: bin/*.apk
